{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relic",
  "version": "../package.json",
  "identifier": "com.relic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Relic",
        "url": "windows/main/index.html",
        "width": 360,
        "height": 520,
        "minWidth": 150,
        "minHeight": 150,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "resizable": true,
        "focus": false,
        "maximizable": false,
        "dragDropEnabled": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "settings",
        "quickpaste",
        "text-editor",
        "pin-image",
        "input-dialog",
        "context-menu",
        "preview-window"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "copyright": "Personal build",
    "icon": [
      "icons/icon32.png",
      "icons/icon64.png",
      "icons/icon128.png",
      "icons/icon256.png",
      "icons/icon1024.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "bundle-scripts/windows/nsis/installer-hooks.nsh",
        "installMode": "perMachine",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
